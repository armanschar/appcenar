<div class="max-w-2xl mx-auto px-6 py-8">
  <div class="bg-white shadow-lg rounded-2xl p-8 border border-gray-200">
    <!-- Título -->
    <h1 class="text-2xl font-semibold text-gray-800 mb-6 flex items-center gap-2">
      <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" stroke-width="2"
        viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M12 4v16m8-8H4" />
      </svg>
      Editar Configuración
    </h1>

    <!-- Formulario -->
    <form action="/admin/configuracion/editar/{{configuracion.id}}" method="POST" class="space-y-6">
      
      <!-- Campo ITBIS -->
      <div>
        <label for="value" class="block text-sm font-medium text-gray-700 mb-2">
          ITBIS (%)
        </label>
        <input 
          type="number" 
          id="value" 
          name="value" 
          value="{{configuracion.value}}" 
          required="required" 
          class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-400 focus:border-green-400 transition"
        >
      </div>

      <input type="hidden" name="key" value="{{configuracion.key}}">
      <input type="hidden" name="description" value="{{configuracion.description}}">
      <input type="hidden" name="isActive" value="{{configuracion.isActive}}">

      <!-- Botones -->
      <div class="flex justify-end gap-4 pt-4">
        <a href="/admin/configuracion" 
           class="px-5 py-2 rounded-lg border border-gray-400 text-gray-700 hover:bg-gray-100 transition">
          ← Volver
        </a>
        <button type="submit" 
                class="px-5 py-2 rounded-lg bg-green-500 text-white font-medium hover:bg-green-600 shadow-md transition">
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</div>
