<div class="max-w-4xl w-full mx-auto bg-white rounded-lg shadow-md p-8">
  <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Registro de Comercio</h2>
  
  <form action="/register-commerce" method="POST" enctype="multipart/form-data" class="space-y-6">
    
    <div>
      <label for="commerceName" class="block text-sm font-medium text-gray-700 mb-2">
        Nombre del Comercio *
      </label>
      <input 
        type="text" 
        id="commerceName" 
        name="commerceName" 
        value="{{formData.commerceName}}"
        required 
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
        placeholder="Ingresa el nombre de tu comercio"
      >
    </div>

    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
        Teléfono *
      </label>
      <input 
        type="tel" 
        id="phone" 
        name="phone" 
        value="{{formData.phone}}"
        required 
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
        placeholder="Ej: 809-123-4567"
      >
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
        Correo Electrónico *
      </label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        value="{{formData.email}}"
        required 
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
        placeholder="comercio@ejemplo.com"
      >
    </div>

    <div>
      <label for="logo" class="block text-sm font-medium text-gray-700 mb-2">
        Logo del Comercio
      </label>
      <input 
        type="file" 
        id="logo" 
        name="logo" 
        accept="image/*"
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100"
      >
      <p class="text-xs text-gray-500 mt-1">Formatos permitidos: JPG, PNG, GIF, WebP. Máximo 5MB.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="openingTime" class="block text-sm font-medium text-gray-700 mb-2">
          Hora de Apertura *
        </label>
        <input 
          type="time" 
          id="openingTime" 
          name="openingTime" 
          value="{{formData.openingTime}}"
          required 
          class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
        >
      </div>
      
      <div>
        <label for="closingTime" class="block text-sm font-medium text-gray-700 mb-2">
          Hora de Cierre *
        </label>
        <input 
          type="time" 
          id="closingTime" 
          name="closingTime" 
          value="{{formData.closingTime}}"
          required 
          class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
        >
      </div>
    </div>

    <div>
      <label for="commerceTypeId" class="block text-sm font-medium text-gray-700 mb-2">
        Tipo de Comercio *
      </label>
      <select 
        id="commerceTypeId" 
        name="commerceTypeId" 
        required 
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
      >
        <option value="">Selecciona el tipo de comercio</option>
        {{#each commerceTypes}}
          <option value="{{this.id}}" {{#if (Equals this.id ../formData.commerceTypeId)}}selected{{/if}}>
            {{this.name}}
          </option>
        {{/each}}
      </select>
      {{#unless commerceTypes}}
        <p class="text-sm text-red-500 mt-1">No hay tipos de comercio disponibles. Contacta al administrador.</p>
      {{/unless}}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
          Contraseña *
        </label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          minlength="6"
          class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
          placeholder="Mínimo 6 caracteres"
        >
      </div>
      
      <div>
        <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
          Confirmar Contraseña *
        </label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          required 
          minlength="6"
          class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
          placeholder="Confirma tu contraseña"
        >
      </div>
    </div>

    <div class="pt-4">
      <button 
        type="submit" 
        class="w-full bg-orange-600 text-white py-3 px-4 rounded-md font-semibold hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 transition duration-200"
      >
        Registrar Comercio
      </button>
    </div>

    <div class="text-center pt-4">
      <p class="text-sm text-gray-600">
        ¿Ya tienes una cuenta? 
        <a href="/" class="text-orange-600 hover:text-orange-700 font-medium">Inicia sesión aquí</a>
      </p>
    </div>
    
  </form>
</div>
