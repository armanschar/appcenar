<div class="bg-white py-12 px-8 shadow-lg rounded-lg max-w-4xl mx-auto w-full">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-900">Crear Cuenta</h2>
    <p class="mt-2 text-sm text-gray-600">Regístrate como Cliente o Delivery</p>
  </div>

  <form action="/register-client-delivery" method="POST" enctype="multipart/form-data" class="space-y-6">
    <div>
      <label for="profileImage" class="block text-sm font-medium text-gray-700 mb-2">
        Foto de Perfil
      </label>
      <input 
        type="file" 
        id="profileImage" 
        name="profileImage"
        required="required"
        accept="image/*" 
        class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100 transition-colors"
      />
      <p class="text-xs text-gray-500 mt-1">PNG, JPG, GIF (MAX. 5MB)</p>
    </div>

    <div>
      <label for="name" class="block text-sm font-medium text-gray-700">Nombre</label>
      <input
        type="text"
        id="name"
        name="name"
        required="required"
        value="{{formData.name}}"
        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-orange-500 focus:border-orange-500"
        placeholder="Tu nombre"
      />
    </div>

    <div>
      <label for="lastName" class="block text-sm font-medium text-gray-700">Apellido</label>
      <input
        type="text"
        id="lastName"
        name="lastName"
        required="required"
        value="{{formData.lastName}}"
        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-orange-500 focus:border-orange-500"
        placeholder="Tu apellido"
      />
    </div>

    <div>
      <label for="username" class="block text-sm font-medium text-gray-700">Nombre de Usuario</label>
      <input
        type="text"
        id="username"
        name="username"
        required="required"
        value="{{formData.username}}"
        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-orange-500 focus:border-orange-500"
        placeholder="Usuario único"
      />
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-gray-700">Correo Electrónico</label>
      <input
        type="email"
        id="email"
        name="email"
        required="required"
        value="{{formData.email}}"
        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-orange-500 focus:border-orange-500"
        placeholder="tu@email.com"
      />
    </div>

    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700">Teléfono</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required="required"
        value="{{formData.phone}}"
        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-orange-500 focus:border-orange-500"
        placeholder="+1234567890"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-3">Tipo de Cuenta</label>
      <div class="space-y-2">
        <div class="flex items-center">
          <input
            type="radio"
            id="cliente"
            name="role"
            value="Cliente"
            required="required"
            {{#if (Equals formData.role "Cliente")}}checked{{/if}}
            class="h-4 w-4 text-orange-600 focus:ring-orange-500 border-gray-300"
          />
          <label for="cliente" class="ml-3 block text-sm text-gray-700">
            Cliente - Ordenar comida
          </label>
        </div>
        <div class="flex items-center">
          <input
            type="radio"
            id="delivery"
            name="role"
            value="Delivery"
            {{#if (Equals formData.role "Delivery")}}checked{{/if}}
            class="h-4 w-4 text-orange-600 focus:ring-orange-500 border-gray-300"
          />
          <label for="delivery" class="ml-3 block text-sm text-gray-700">
            Delivery - Entregar pedidos
          </label>
        </div>
      </div>
    </div>

    <div>
      <label for="password" class="block text-sm font-medium text-gray-700">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        required="required"
        minlength="6"
        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-orange-500 focus:border-orange-500"
        placeholder="Mínimo 6 caracteres"
      />
    </div>

    <div>
      <label for="confirmPassword" class="block text-sm font-medium text-gray-700">Confirmar Contraseña</label>
      <input
        type="password"
        id="confirmPassword"
        name="confirmPassword"
        required="required"
        minlength="6"
        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-orange-500 focus:border-orange-500"
        placeholder="Repite tu contraseña"
      />
    </div>

    <div>
      <button
        type="submit"
        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-white bg-orange-600 hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 transition-colors font-medium"
      >
        Crear Cuenta
      </button>
    </div>

    <div class="text-center">
      <p class="text-sm text-gray-600">
        ¿Ya tienes cuenta?
        <a href="/" class="font-medium text-orange-600 hover:text-orange-500 transition-colors">
          Inicia Sesión
        </a>
      </p>
    </div>
  </form>
</div>
