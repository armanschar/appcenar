<div class="bg-white rounded-xl shadow-xl p-8 max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-8 text-gray-800">Restaurar Contraseña</h2>

    
    <form method="POST" action="/forgot" class="space-y-6">
        <div>
            <label for="Email" class="block text-sm font-medium text-gray-700 mb-2">
                Correo Electrónico
            </label>
            <input
                type="email"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500 transition duration-200"
                id="Email"
                name="Email"
                placeholder="Ingrese su correo electrónico"
                required
            />
        </div>

        <button type="submit" class="w-full bg-orange-500 text-white py-3 px-6 rounded-lg font-semibold hover:bg-orange-600 transform hover:scale-105 transition duration-200 shadow-lg">
            Restaurar Contraseña
        </button>
    </form>
    
    <div class="mt-8 space-y-4">
        <div class="text-center">
            <a href="/" class="text-orange-500 hover:text-orange-600 text-sm underline transition duration-200">
                Volver al inicio de sesión
            </a>
        </div>
    </div>
</div>
