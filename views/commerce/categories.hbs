{{!-- commerce/categories.hbs --}}
<div class="max-w-5xl mx-auto mt-6">
  <h1 class="text-3xl font-bold text-orange-600 mb-6">Mantenimiento de categorías</h1>

  <div class="mb-4 flex justify-between items-center">
    <a href="/commerce/home" class="text-orange-500 hover:underline">← Volver al Home</a>
    <a href="/commerce/categories/create" class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded font-semibold transition">+ Crear Categoría</a>
  </div>

  {{!-- Mensajes se muestran en el layout, por eso no repito aquí --}}

  {{#if categories.length}}
    <table class="min-w-full border border-gray-200 rounded shadow overflow-hidden">
      <thead class="bg-orange-100">
        <tr>
          <th class="px-4 py-2 text-left font-semibold">Nombre</th>
          <th class="px-4 py-2 text-left font-semibold">Descripción</th>
          <th class="px-4 py-2 text-center font-semibold"># Productos</th>
          <th class="px-4 py-2 text-center font-semibold">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each categories}}
          <tr class="border-t border-gray-200 hover:bg-orange-50 transition">
            <td class="px-4 py-3">{{this.name}}</td>
            <td class="px-4 py-3">{{this.description}}</td>
            <td class="px-4 py-3 text-center">{{this.productsCount}}</td>
            <td class="px-4 py-3 text-center space-x-2">
              <a href="/commerce/categories/{{this.id}}/edit" class="text-orange-600 hover:underline font-semibold">Editar</a>

              <form action="/commerce/categories/{{this.id}}/delete" method="POST" class="inline" onsubmit="return confirm('¿Está seguro que desea eliminar esta categoría?');">
                <button type="submit" class="text-red-600 hover:underline font-semibold">Eliminar</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p class="text-gray-600">No hay categorías creadas.</p>
  {{/if}}
</div>
