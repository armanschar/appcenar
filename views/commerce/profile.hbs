{{!-- commerce/profile.hbs --}}
<div class="max-w-3xl mx-auto mt-6">
  <h1 class="text-3xl font-bold text-orange-600 mb-6">Mi Perfil</h1>

  <a href="/commerce/home" class="inline-block mb-4 text-orange-500 hover:underline">← Volver al Home</a>

  <form action="/commerce/profile" method="POST" enctype="multipart/form-data" class="space-y-6 bg-white p-6 rounded-lg shadow border border-gray-200">
    <div>
      <label class="block font-semibold mb-1">Logo actual:</label>
      {{#if commerce.commerceLogo}}
        <img src="{{commerce.commerceLogo}}" alt="Logo del comercio" class="w-40 h-40 object-contain rounded border" />
      {{else}}
        <div class="w-40 h-40 bg-gray-200 rounded border flex items-center justify-center">
          <p class="text-gray-500 text-sm text-center">No hay logo cargado</p>
        </div>
      {{/if}}
    </div>

    <div>
      <label for="logo" class="block font-semibold mb-1">Cambiar logo:</label>
      <input type="file" name="logo" id="logo" accept="image/*" class="border rounded px-3 py-2 w-full" />
      <p class="text-sm text-gray-500 mt-1">Formatos permitidos: JPEG, PNG, GIF, WebP. Tamaño máximo: 5MB</p>
    </div>

    <div>
      <label for="openingTime" class="block font-semibold mb-1">Hora de apertura:</label>
      <input type="time" name="openingTime" id="openingTime" required="required"
        value="{{#if formData.openingTime}}{{formData.openingTime}}{{else}}{{commerce.openingTime}}{{/if}}"
        class="border rounded px-3 py-2 w-full" />
    </div>

    <div>
      <label for="closingTime" class="block font-semibold mb-1">Hora de cierre:</label>
      <input type="time" name="closingTime" id="closingTime" required="required"
        value="{{#if formData.closingTime}}{{formData.closingTime}}{{else}}{{commerce.closingTime}}{{/if}}"
        class="border rounded px-3 py-2 w-full" />
    </div>

    <div>
      <label for="phone" class="block font-semibold mb-1">Teléfono:</label>
      <input type="text" name="phone" id="phone" required="required"
        value="{{#if formData.phone}}{{formData.phone}}{{else}}{{commerce.phone}}{{/if}}"
        class="border rounded px-3 py-2 w-full" />
    </div>

    <div>
      <label for="email" class="block font-semibold mb-1">Correo electrónico:</label>
      <input type="email" name="email" id="email" required="required"
        value="{{#if formData.email}}{{formData.email}}{{else}}{{commerce.email}}{{/if}}"
        class="border rounded px-3 py-2 w-full" />
    </div>

    <div class="flex space-x-4">
      <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-2 rounded transition">
        Guardar cambios
      </button>
      <a href="/commerce/home" class="inline-block px-6 py-2 text-orange-600 hover:underline">
        ← Cancelar
      </a>
    </div>
  </form>
</div>