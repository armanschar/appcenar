<div class="max-w-6xl mx-auto mt-6">
  <h1 class="text-3xl font-bold text-orange-600 mb-6">Mantenimiento de Productos</h1>

  <div class="mb-4 flex justify-between items-center">
    <a href="/commerce/home" class="text-orange-500 hover:underline">← Volver al Home</a>
    <a href="/commerce/products/create" class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded font-semibold transition">+ Crear Producto</a>
  </div>

  {{#if products.length}}
    <table class="min-w-full border border-gray-200 rounded shadow overflow-hidden">
      <thead class="bg-orange-100">
        <tr>
          <th class="px-4 py-2 text-left font-semibold">Nombre</th>
          <th class="px-4 py-2 text-left font-semibold">Imagen</th>
          <th class="px-4 py-2 text-left font-semibold">Descripción</th>
          <th class="px-4 py-2 text-left font-semibold">Categoría</th>
          <th class="px-4 py-2 text-right font-semibold">Precio</th>
          <th class="px-4 py-2 text-center font-semibold">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each products}}
          <tr class="border-t border-gray-200 hover:bg-orange-50 transition">
            <td class="px-4 py-3">{{this.name}}</td>
            <td class="px-4 py-3">
              {{#if this.image}}
                <img src="{{this.image}}" alt="{{this.name}}" class="w-20 h-20 object-contain rounded" />
              {{else}}
                <span class="text-gray-400 italic">Sin imagen</span>
              {{/if}}
            </td>
            <td class="px-4 py-3">{{this.description}}</td>
            <td class="px-4 py-3">{{this.category.name}}</td>
            <td class="px-4 py-3 text-right">${{this.price}}</td>
            <td class="px-4 py-3 text-center space-x-2">
              <a href="/commerce/products/{{this.id}}/edit" class="text-orange-600 hover:underline font-semibold">Editar</a>
              <form action="/commerce/products/{{this.id}}/delete" method="POST" class="inline" onsubmit="return confirm('¿Está seguro que desea eliminar este producto?');">
                <button type="submit" class="text-red-600 hover:underline font-semibold">Eliminar</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p class="text-gray-600">No hay productos creados.</p>
  {{/if}}
</div>
