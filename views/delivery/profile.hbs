<!-- Header del perfil -->
<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold mb-2 flex items-center gap-3 text-gray-800">
        👤 Mi Perfil
      </h1>
      <p class="text-gray-600 text-lg">Gestiona tu información personal</p>
    </div>
    <div class="text-right">
      <span class="text-5xl opacity-30">⚙️</span>
    </div>
  </div>
</div>

<div class="max-w-4xl mx-auto px-4">
  
  <!-- Información personal actual -->
  <div class="bg-white rounded-2xl p-8 mb-8 shadow-lg border-l-4 border-orange-500">
    <div class="flex items-center mb-6">
      <span class="text-2xl mr-3">📋</span>
      <h2 class="text-2xl font-bold text-gray-800">Información Personal Actual</h2>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <div class="flex items-center mb-4 p-3 rounded-lg bg-gray-50">
          <span class="font-semibold text-gray-700 min-w-[120px] flex items-center gap-2">
            👤 Nombre:
          </span>
          <span class="text-gray-800 font-medium">{{user.name}}</span>
        </div>
        
        <div class="flex items-center mb-4 p-3 rounded-lg bg-gray-50">
          <span class="font-semibold text-gray-700 min-w-[120px] flex items-center gap-2">
            👨‍💼 Apellido:
          </span>
          <span class="text-gray-800 font-medium">{{user.lastName}}</span>
        </div>
        
        <div class="flex items-center mb-4 p-3 rounded-lg bg-gray-50">
          <span class="font-semibold text-gray-700 min-w-[120px] flex items-center gap-2">
            📧 Correo:
          </span>
          <span class="text-gray-800 font-medium">{{user.email}}</span>
        </div>
        
        <div class="flex items-center mb-4 p-3 rounded-lg bg-gray-50">
          <span class="font-semibold text-gray-700 min-w-[120px] flex items-center gap-2">
            📱 Teléfono:
          </span>
          <span class="text-gray-800 font-medium">{{user.phone}}</span>
        </div>
      </div>
      
      <div class="flex justify-center items-center">
        <div class="text-center">
          <p class="text-sm text-gray-600 mb-4">Foto de perfil actual</p>
          {{#if user.profileImage}}
            <img src="{{user.profileImage}}" alt="Foto de perfil" class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-xl mx-auto">
          {{else}}
            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-white text-5xl border-4 border-white shadow-xl mx-auto">
              <span>👤</span>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  <!-- Formulario de actualización -->
  <div class="bg-white rounded-2xl p-8 mb-8 shadow-lg border-l-4 border-blue-500">
    <div class="flex items-center mb-6">
      <span class="text-2xl mr-3">✏️</span>
      <h2 class="text-2xl font-bold text-gray-800">Actualizar Información</h2>
    </div>
    
    <form action="/delivery/profile/update" method="POST" enctype="multipart/form-data">
      
      <div class="grid md:grid-cols-2 gap-6">
        <div class="mb-6">
          <label for="name" class="block font-semibold text-gray-700 mb-2 flex items-center gap-2">
            👤 Nombre
          </label>
          <input type="text" 
                 name="name" 
                 id="name" 
                 value="{{user.name}}" 
                 required
                 class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-base transition-all duration-300 focus:outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-200"
                 placeholder="Ingresa tu nombre">
        </div>

        <div class="mb-6">
          <label for="lastName" class="block font-semibold text-gray-700 mb-2 flex items-center gap-2">
            👨‍💼 Apellido
          </label>
          <input type="text" 
                 name="lastName" 
                 id="lastName" 
                 value="{{user.lastName}}" 
                 required
                 class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-base transition-all duration-300 focus:outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-200"
                 placeholder="Ingresa tu apellido">
        </div>
      </div>

      <div class="mb-6">
        <label for="email" class="block font-semibold text-gray-700 mb-2 flex items-center gap-2">
          📧 Correo electrónico
          <span class="text-xs bg-gray-200 text-gray-600 px-2 py-1 rounded-full ml-2">Solo lectura</span>
        </label>
        <input type="email" 
               name="email" 
               id="email" 
               value="{{user.email}}" 
               readonly
               class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-base bg-gray-100 text-gray-600 cursor-not-allowed"
               title="El correo no puede ser modificado">
      </div>

      <div class="mb-6">
        <label for="phone" class="block font-semibold text-gray-700 mb-2 flex items-center gap-2">
          📱 Teléfono
        </label>
        <input type="text" 
               name="phone" 
               id="phone" 
               value="{{user.phone}}" 
               required
               class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-base transition-all duration-300 focus:outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-200"
               placeholder="Ingresa tu teléfono">
      </div>

      <div class="mb-6">
        <label class="block font-semibold text-gray-700 mb-2 flex items-center gap-2">
          📸 Foto de perfil
        </label>
        <div class="relative">
          <input type="file" 
                 name="profileImage" 
                 id="profileImage" 
                 accept="image/*"
                 class="absolute opacity-0 w-full h-full cursor-pointer">
          <label for="profileImage" class="block w-full border-2 border-dashed border-gray-300 rounded-lg p-6 text-center cursor-pointer transition-all duration-300 hover:border-orange-500 hover:bg-orange-50">
            <div class="text-center">
              <span class="text-4xl mb-2 block">📷</span>
              <p class="text-gray-700 font-medium mb-1">Haz clic para seleccionar una imagen</p>
              <p class="text-gray-500 text-sm">PNG, JPG, GIF hasta 10MB</p>
            </div>
          </label>
        </div>
        {{#if user.profileImage}}
          <p class="mt-3 text-sm text-gray-600 bg-gray-50 p-2 rounded-lg">
            <span class="font-medium">📁 Archivo actual:</span> {{user.profileImage}}
          </p>
        {{/if}}
      </div>

      <!-- Botones de acción -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <a href="/delivery/home" class="bg-gray-600 hover:bg-gray-700 text-white py-3 px-8 rounded-full font-semibold transition-all duration-300 text-center hover:transform hover:-translate-y-1 hover:shadow-lg">
          ⬅️ Volver al Panel
        </a>
        <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white py-3 px-8 rounded-full font-semibold transition-all duration-300 hover:transform hover:-translate-y-1 hover:shadow-lg">
          💾 Actualizar Perfil
        </button>
      </div>

    </form>
  </div>

</div>

<!-- Script para mejorar la experiencia del file input -->
<script>
document.getElementById('profileImage').addEventListener('change', function(e) {
  const label = document.querySelector('label[for="profileImage"]');
  const fileName = e.target.files[0]?.name;
  
  if (fileName) {
    label.innerHTML = `
      <div class="text-center">
        <span class="text-4xl mb-2 block">✅</span>
        <p class="text-gray-700 font-medium mb-1">Imagen seleccionada</p>
        <p class="text-gray-600 text-sm">${fileName}</p>
      </div>
    `;
    label.style.borderColor = '#10b981';
    label.style.backgroundColor = 'rgba(16, 185, 129, 0.05)';
  }
});
</script>