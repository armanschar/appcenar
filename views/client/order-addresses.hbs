
<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Seleccionar Dirección</h1>
                    <p class="mt-2 text-gray-600">Elige dónde quieres recibir tu pedido</p>
                </div>
                <a href="/client/commerce/{{commerce.id}}/catalog" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Volver al Catálogo
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="p-6 border-b border-gray-200">
                        <h2 class="text-xl font-semibold text-gray-900">Mis Direcciones</h2>
                        <p class="mt-1 text-sm text-gray-600">Selecciona la dirección donde quieres recibir tu pedido</p>
                    </div>

                    <div class="p-6">
                        {{#if hasAddresses}}
                            <form method="POST" action="/client/order-addresses" id="address-form">
                                <input type="hidden" name="commerceId" value="{{commerce.id}}">
                                
                                <div class="space-y-4">
                                    {{#each addresses}}
                                    <label class="relative flex items-start p-4 border-2 rounded-lg cursor-pointer hover:bg-gray-50 transition-colors address-option" data-address-id="{{id}}">
                                        <input type="radio" name="addressId" value="{{id}}" class="mt-1 h-4 w-4 text-orange-600 border-gray-300 focus:ring-orange-500">
                                        <div class="ml-3 flex-1">
                                            <div class="flex items-center justify-between">
                                                <h3 class="text-lg font-medium text-gray-900">{{name}}</h3>
                                                <span class="text-xs text-gray-500">
                                                    <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    </svg>
                                                </span>
                                            </div>
                                            <p class="mt-1 text-gray-600">{{description}}</p>
                                        </div>
                                    </label>
                                    {{/each}}
                                </div>

                                <div class="mt-6 flex items-center justify-between">
                                    <a href="/client/addresses/create?redirect=/client/order-addresses&commerceId={{commerce.id}}" class="inline-flex items-center px-4 py-2 border border-orange-600 rounded-lg text-sm font-medium text-orange-600 hover:bg-orange-50 transition-colors">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        Agregar Nueva Dirección
                                    </a>
                                    
                                    <button type="submit" id="continue-btn" disabled class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-gray-400 cursor-not-allowed transition-colors">
                                        Confirmar Pedido
                                        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                        </svg>
                                    </button>
                                </div>
                            </form>
                        {{else}}
                            <div class="text-center py-12">
                                <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <h3 class="text-lg font-medium text-gray-900 mb-2">No tienes direcciones guardadas</h3>
                                <p class="text-gray-600 mb-6">Necesitas agregar al menos una dirección para continuar con tu pedido.</p>
                                <a href="/client/addresses/create?redirect=/client/order-addresses&commerceId={{commerce.id}}" class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-orange-600 hover:bg-orange-700 transition-colors">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    Crear Mi Primera Dirección
                                </a>
                            </div>
                        {{/if}}
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 sticky top-8">
                    <div class="p-6 border-b border-gray-200">
                        <div class="flex items-center space-x-4">
                            <div class="w-20 h-20 bg-gray-100 rounded-lg flex items-center justify-center overflow-hidden">
                                {{#if commerce.commerceLogo}}
                                    <img src="{{commerce.commerceLogo}}" alt="{{commerce.commerceName}}" class="w-full h-full object-contain">
                                {{else if commerce.profileImage}}
                                    <img src="{{commerce.profileImage}}" alt="{{commerce.commerceName}}" class="w-full h-full object-contain">
                                {{else}}
                                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                    </svg>
                                {{/if}}
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">{{commerce.commerceName}}</h3>
                                <p class="text-sm text-gray-600">{{commerce.commerceType.name}}</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-6 border-b border-gray-200">
                        <h4 class="text-sm font-medium text-gray-900 mb-4">Productos ({{cart.length}})</h4>
                        <div class="space-y-3">
                            {{#each cart}}
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
                                    <img src="{{image}}" alt="{{name}}" class="w-full h-full object-cover rounded-lg"/>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">{{name}}</p>
                                    <p class="text-xs text-gray-500 truncate">{{description}}</p>
                                </div>
                                <p class="text-sm font-medium text-gray-900">RD$ {{price}}</p>
                            </div>
                            {{/each}}
                        </div>
                    </div>

                    <div class="p-6">
                        <div class="space-y-3">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">Subtotal</span>
                                <span class="font-medium text-gray-900">RD$ {{subtotal}}</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">ITBIS ({{itbisPercentage}}%)</span>
                                <span class="font-medium text-gray-900">RD$ {{itbisAmount}}</span>
                            </div>
                            <div class="border-t border-gray-200 pt-3">
                                <div class="flex justify-between">
                                    <span class="text-base font-medium text-gray-900">Total</span>
                                    <span class="text-lg font-bold text-orange-600">RD$ {{total}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Scripts -->
<script src="/js/order-addresses.js"></script>
