
<div class="min-h-[calc(100vh-4rem)] bg-gray-50 flex items-center justify-center">
    <div class="w-full max-w-4xl mx-auto px-4 py-8">
        
  
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">
                ¡Bienvenido, {{user.name}}!
            </h1>
            <p class="text-gray-600">¿Qué tipo de comercio buscas hoy?</p>
        </div>

        <div class="flex justify-center mb-12">
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 max-w-4xl w-full justify-items-center">
                {{#each commerceTypes}}
                <a href="/client/commerces?type={{this.id}}" class="bg-white rounded-lg shadow-md p-4 text-center transition-all duration-300 hover:shadow-lg hover:scale-105 hover:border-orange-500 border-2 border-transparent min-h-[120px] flex flex-col justify-center w-full max-w-[140px]">
                    <div class="mb-2">
                        {{#if this.icon}}
                            <div class="w-12 h-12 mx-auto bg-orange-100 rounded-full flex items-center justify-center text-xl">
                                <img src="{{this.icon}}" alt="{{this.name}}" class="h-12 w-12 object-contain">
                            </div>
                        {{else}}
                            <div class="w-12 h-12 mx-auto bg-orange-100 rounded-full flex items-center justify-center transition-all duration-300">
                                <svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                </svg>
                            </div>
                        {{/if}}
                    </div>
                    
                    <h3 class="font-semibold text-gray-800 text-sm transition-colors duration-300 hover:text-orange-600 leading-tight">{{this.name}}</h3>
                </a>
                {{/each}}
                
                {{#unless commerceTypes}}
                <div class="col-span-full text-center py-12">
                    <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    <h3 class="text-lg font-medium text-gray-500 mb-2">No hay tipos de comercio disponibles</h3>
                    <p class="text-gray-400">Los tipos de comercio aparecerán aquí una vez que sean creados por un administrador.</p>
                </div>
                {{/unless}}
            </div>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-lg max-w-2xl mx-auto mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4 text-center">Accesos Rápidos</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <a href="/client/profile" class="bg-gray-50 rounded-lg p-4 text-center transition-all duration-200 hover:shadow-lg hover:scale-105 hover:bg-orange-50">
                    <svg class="w-8 h-8 mx-auto text-blue-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span class="text-sm font-medium text-gray-700">Mi Perfil</span>
                </a>
                
                <a href="/client/orders" class="bg-gray-50 rounded-lg p-4 text-center transition-all duration-200 hover:shadow-lg hover:scale-105 hover:bg-orange-50">
                    <svg class="w-8 h-8 mx-auto text-green-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                    </svg>
                    <span class="text-sm font-medium text-gray-700">Mis Pedidos</span>
                </a>
                
                <a href="/client/addresses" class="bg-gray-50 rounded-lg p-4 text-center transition-all duration-200 hover:shadow-lg hover:scale-105 hover:bg-orange-50">
                    <svg class="w-8 h-8 mx-auto text-purple-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="text-sm font-medium text-gray-700">Mis Direcciones</span>
                </a>
                
                <a href="/client/favorites" class="bg-gray-50 rounded-lg p-4 text-center transition-all duration-200 hover:shadow-lg hover:scale-105 hover:bg-orange-50">
                    <svg class="w-8 h-8 mx-auto text-red-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <span class="text-sm font-medium text-gray-700">Mis Favoritos</span>
                </a>
            </div>
        </div>
    </div>
</div>
