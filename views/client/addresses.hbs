
<div class="min-h-[calc(100vh-4rem)] bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4">
        
        <div class="mb-8">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">Mis Direcciones</h1>
                    <p class="text-gray-600">Gestiona tus direcciones de entrega</p>
                </div>
                <a 
                    href="/client/addresses/create" 
                    class="bg-orange-500 text-white py-2 px-4 rounded-lg font-semibold hover:bg-orange-600 transition duration-200 flex items-center space-x-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>Nueva Dirección</span>
                </a>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg">
            {{#if addresses}}
                <div class="p-6">
                    <div class="space-y-4">
                        {{#each addresses}}
                            <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow duration-200">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold text-gray-800 mb-2">{{this.name}}</h3>
                                        <p class="text-gray-600">{{this.description}}</p>
                                    </div>
                                    <div class="flex space-x-2 ml-4">
                                        <a 
                                            href="/client/addresses/edit/{{this.id}}" 
                                            class="bg-blue-500 text-white py-1 px-3 rounded text-sm font-medium hover:bg-blue-600 transition duration-200 flex items-center space-x-1"
                                        >
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                            </svg>
                                            <span>Editar</span>
                                        </a>
                                        <a 
                                            href="/client/addresses/delete/{{this.id}}" 
                                            class="bg-red-500 text-white py-1 px-3 rounded text-sm font-medium hover:bg-red-600 transition duration-200 flex items-center space-x-1"
                                        >
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            <span>Eliminar</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            {{else}}
                <div class="p-12 text-center">
                    <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No tienes direcciones</h3>
                    <p class="text-gray-500 mb-6">Crea tu primera dirección de entrega para comenzar a realizar pedidos.</p>
                </div>
            {{/if}}
        </div>

        <div class="mt-8 text-center">
            <a 
                href="/client/home" 
                class="bg-gray-500 text-white py-2 px-6 rounded-lg font-semibold hover:bg-gray-600 transition duration-200 inline-flex items-center space-x-2"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                <span>Volver al Inicio</span>
            </a>
        </div>
    </div>
</div>