{{!-- Client Profile  --}}
<div class="min-h-[calc(100vh-4rem)] bg-gray-50 py-8">
    <div class="max-w-2xl mx-auto px-4">
        
        
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Mi Perfil</h1>
            <p class="text-gray-600">Actualiza tu información personal</p>
        </div>

        
        <div class="bg-white rounded-xl shadow-lg p-8">
            <form action="/client/profile" method="POST" enctype="multipart/form-data" class="space-y-6">
                
                
                <div class="mb-6">
                    {{#if userData.profileImage}}
                        <div class="text-center mb-4">
                            <img 
                                src="{{userData.profileImage}}" 
                                alt="Foto de perfil actual" 
                                class="w-24 h-24 rounded-full object-cover border-4 border-orange-200 shadow-lg mx-auto"
                            >
                            <p class="text-sm text-gray-500 mt-2">Imagen actual</p>
                        </div>
                    {{/if}}
                    
                    <div>
                        <label for="profileImage" class="block text-sm font-medium text-gray-700 mb-2">
                            {{#if userData.profileImage}}Cambiar Foto de Perfil{{else}}Foto de Perfil{{/if}}
                        </label>
                        <input 
                            type="file" 
                            id="profileImage" 
                            name="profileImage" 
                            accept="image/*"
                            class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100 transition-colors"
                        >
                        {{#if userData.profileImage}}
                            <p class="text-xs text-gray-500 mt-1">Deje vacío para mantener la imagen actual</p>
                        {{else}}
                            <p class="text-xs text-gray-500 mt-1">PNG, JPG, GIF (MAX. 5MB)</p>
                        {{/if}}
                    </div>
                </div>

                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                            Nombre *
                        </label>
                        <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            value="{{#if formData.name}}{{formData.name}}{{else}}{{userData.name}}{{/if}}"
                            required 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500 transition duration-200"
                            placeholder="Ingresa tu nombre"
                        >
                    </div>

                    
                    <div>
                        <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">
                            Apellido *
                        </label>
                        <input 
                            type="text" 
                            id="lastName" 
                            name="lastName" 
                            value="{{#if formData.lastName}}{{formData.lastName}}{{else}}{{userData.lastName}}{{/if}}"
                            required 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500 transition duration-200"
                            placeholder="Ingresa tu apellido"
                        >
                    </div>
                </div>

                
                <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                        Teléfono *
                    </label>
                    <input 
                        type="tel" 
                        id="phone" 
                        name="phone" 
                        value="{{#if formData.phone}}{{formData.phone}}{{else}}{{userData.phone}}{{/if}}"
                        required 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500 transition duration-200"
                        placeholder="Ej: 809-123-4567"
                    >
                </div>

                
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                        Correo Electrónico
                    </label>
                    <input 
                        type="email" 
                        id="email" 
                        value="{{userData.email}}"
                        readonly 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed"
                        placeholder="correo@ejemplo.com"
                    >
                    <p class="text-xs text-gray-500 mt-1">El correo electrónico no se puede modificar</p>
                </div>

                
                {{#if userData.username}}
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-2">
                        Nombre de Usuario
                    </label>
                    <input 
                        type="text" 
                        id="username" 
                        value="{{userData.username}}"
                        readonly 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed"
                    >
                    <p class="text-xs text-gray-500 mt-1">El nombre de usuario no se puede modificar</p>
                </div>
                {{/if}}

                
                <div class="flex flex-col sm:flex-row gap-4 pt-6">
                    <a 
                        href="/client/home" 
                        class="flex-1 bg-gray-500 text-white py-3 px-6 rounded-lg font-semibold hover:bg-gray-600 transition duration-200 text-center flex items-center justify-center space-x-2"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        <span>Volver al Inicio</span>
                    </a>
                    
                    <button 
                        type="submit" 
                        class="flex-1 bg-orange-500 text-white py-3 px-6 rounded-lg font-semibold hover:bg-orange-600 transform hover:scale-105 transition duration-200 flex items-center justify-center space-x-2"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span>Guardar Cambios</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>